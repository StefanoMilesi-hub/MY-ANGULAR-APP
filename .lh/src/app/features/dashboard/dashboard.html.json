            "date": 1781008346017,
            "name": "Commit-0",
            "content": "<div class=\"dashboard-container\">\r\n  <div class=\"dashboard-header\">\r\n    <h1>Dashboard</h1>\r\n    <p>Benvenuto nel tuo cruscotto di amministrazione</p>\r\n  </div>\r\n\r\n  <div class=\"form-card\">\r\n    <form [formGroup]=\"homeform\" (ngSubmit)=\"onSubmit()\">\r\n      <div class=\"form-field\">\r\n        <div class=\"icon-input\">\r\n          <span\r\n            *ngFor=\"let ic of icons\"\r\n            class=\"icon-item\"\r\n            [class.selected]=\"homeform.get('icon')?.value === ic\"\r\n            (click)=\"selectIcon(ic)\"\r\n          >\r\n            {{ ic }}\r\n          </span>\r\n        <input\r\n          style=\"width: 30px\"\r\n          formControlName=\"icon\" \r\n          placeholder=\"icon\"/>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"form-field\">\r\n        <div class=\"stat-header\">\r\n          <span class=\"stat-change\" [class]=\"changeClass\">\r\n             📈 / 📉  \r\n            <input id=\"stat-change\" formControlName=\"change\" placeholder=\"Variazione %\" type=\"number\" min=\"-100\" max=\"100\" step=\"1.1-2\"/>\r\n            %\r\n          </span>\r\n          \r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"form-field\">\r\n        <h3 class=\"stat-title\">\r\n          <input id=\"stat-title\" formControlName=\"title\" placeholder=\"Titolo card\" />\r\n        </h3>\r\n\r\n        <p class=\"stat-value\">\r\n          <input id=\"stat-value\" formControlName=\"value\" placeholder=\"Valore card\" type=\"number\" min=\"0\" max=\"10000000\" step=\"1\"/>\r\n        </p>\r\n      </div>  \r\n\r\n    <div class=\"form-actions\">\r\n      <button type=\"submit\" class=\"btn-primary\" [disabled]=\"!homeform.valid\">Invia</button>\r\n    </div>\r\n    </form>\r\n  </div>\r\n\r\n  <div class=\"stats-grid\">\r\n    @for (stat of dashboardStats(); track stat.id) {\r\n      <app-stat-card\r\n        [id]=\"stat.id\"\r\n        [title]=\"stat.title\"\r\n        [value]=\"stat.value\"\r\n        [change]=\"stat.change\"\r\n        [icon]=\"stat.icon\"\r\n        [color]=\"stat.color\"\r\n        (deleteStat)=\"onDeleteStat($event)\"\r\n      />\r\n    }\r\n  </div>\r\n\r\n  <div class=\"dashboard-content\">\r\n    <div class=\"main-section\">\r\n      <app-items-list\r\n        [items]=\"dashboardItems()\"\r\n        (itemAdded)=\"onItemAdded($event)\"\r\n        (deleteItem)=\"onDeleteItem($event)\"\r\n      ></app-items-list>\r\n    </div>\r\n\r\n    <div class=\"sidebar-section\">\r\n      <div class=\"quick-actions\">\r\n        <h3>Azioni Rapide</h3>\r\n        <ul>\r\n          <li>\r\n            <button class=\"action-btn\" mat-button (click)=\"openDialog()\">+ Nuovo Progetto</button>\r\n          </li>\r\n           <li>\r\n            <button class=\"action-btn\" mat-button (click)=\"openDialogReport()\">📊 Esporta Report</button>\r\n          </li>\r\n          <li>\r\n            <button class=\"action-btn\" mat-button (click)=\"openDialogSettings()\">⚙️ Settings</button>\r\n          </li>\r\n          <li><button class=\"action-btn\">👥 Gestisci Utenti</button></li>\r\n        </ul>\r\n      </div>\r\n\r\n      <div class=\"activity-feed\">\r\n        <h3>Attività Recente</h3>\r\n        <div class=\"activity-item\">\r\n          <span class=\"activity-icon\">✅</span>\r\n          <div class=\"activity-text\">\r\n            <p>Progetto completato</p>\r\n            <small>2 ore fa</small>\r\n          </div>\r\n        </div>\r\n        <div class=\"activity-item\">\r\n          <span class=\"activity-icon\">👤</span>\r\n          <div class=\"activity-text\">\r\n            <p>Nuovo utente iscritto</p>\r\n            <small>5 ore fa</small>\r\n          </div>\r\n        </div>\r\n        <div class=\"activity-item\">\r\n          <span class=\"activity-icon\">📈</span>\r\n          <div class=\"activity-text\">\r\n            <p>Aumento conversioni</p>\r\n            <small>1 giorno fa</small>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n"
        }
    ]
